filters:
  and:
    - tipo == "concepto"
    - not:
        - file.inFolder("90 Plantillas")
properties:
  file.name:
    displayName: Concepto
  asignatura:
    displayName: Asignatura
  tema:
    displayName: Tema
  estado:
    displayName: Estado
  confianza:
    displayName: Confianza
  proxima_revision:
    displayName: Próxima revisión
  repasar:
    displayName: Repasar
  nivel_revision:
    displayName: Nivel
  ultima_revision:
    displayName: Última revisión
views:
  - type: table
    name: Por tema
    groupBy:
      property: tema
      direction: ASC
    order:
      - file.name
      - asignatura
      - estado
      - confianza
      - nivel_revision
      - ultima_revision
      - proxima_revision
  - type: table
    name: Por asignatura
    groupBy:
      property: asignatura
      direction: ASC
    order:
      - file.name
      - tema
      - estado
      - confianza
      - nivel_revision
      - ultima_revision
      - proxima_revision
  - type: table
    name: Bandeja de entrada
    filters:
      and:
        - estado == "borrador"
    order:
      - file.name
      - asignatura
      - tema
      - file.mtime
  - type: table
    name: Semáforo
    groupBy:
      property: confianza
      direction: ASC
    order:
      - file.name
      - asignatura
      - estado
      - proxima_revision
